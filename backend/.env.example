# ==============================================================================
# FRIDAY Backend - Environment Configuration Example
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# For Render deployment, configure these in the Render Dashboard Environment tab.
# ==============================================================================

# Application Meta
APP_NAME=FRIDAY
VERSION=0.1.0
ENV=production

# Server Port (Render sets this automatically; default: 8000)
PORT=8000

# CORS Allowed Origins
# Comma-separated list of allowed frontend origins.
# For Vercel production deployment, set to your Vercel URL (e.g., https://your-friday-app.vercel.app)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-friday-app.vercel.app

# ==============================================================================
# AI Model Provider Routing
# ==============================================================================
# Options: "openrouter", "gemini", "ollama"
# In production on Render, use "openrouter" or "gemini".
# "ollama" is supported for local offline development.
DEFAULT_AI_PROVIDER=openrouter
JOB_ANALYSIS_PROVIDER=openrouter

# ==============================================================================
# OpenRouter Configuration (Recommended for Render)
# ==============================================================================
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ==============================================================================
# Google Gemini Configuration (Alternative Provider)
# ==============================================================================
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ==============================================================================
# Local Ollama Configuration (Local Development Only)
# ==============================================================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

