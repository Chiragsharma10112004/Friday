# ==============================================================================
# FRIDAY - Full Stack Environment Configuration Example
# ==============================================================================
# Backend: Deploy on Render (configure in Render Dashboard)
# Frontend: Deploy on Vercel (configure in Vercel Dashboard)
# ==============================================================================

# --- Backend Configuration (Render) ---
APP_NAME=FRIDAY
VERSION=0.1.0
ENV=production
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-friday-app.vercel.app

# AI Provider Routing (Options: "openrouter", "gemini", "ollama")
DEFAULT_AI_PROVIDER=openrouter
JOB_ANALYSIS_PROVIDER=openrouter

# OpenRouter (Recommended for Render)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Google Gemini (Alternative)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Local Development Only
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# --- Frontend Configuration (Vercel) ---
NEXT_PUBLIC_API_URL=https://your-friday-backend.onrender.com

