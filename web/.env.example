# ==============================================================================
# FRIDAY Frontend - Environment Configuration Example
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# For Vercel deployment, configure NEXT_PUBLIC_API_URL in the Vercel Dashboard:
#   Project Settings -> Environment Variables -> NEXT_PUBLIC_API_URL
# ==============================================================================

# URL to your deployed FastAPI backend on Render
# In production: https://your-friday-backend.onrender.com
# In local development: http://localhost:8000
NEXT_PUBLIC_API_URL=https://your-friday-backend.onrender.com

